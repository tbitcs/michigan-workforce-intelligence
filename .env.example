# Copy to .env. Docker Compose reads this file; no host Python is needed.
COMPOSE_PROJECT_NAME=michigan-workforce-intelligence
MIJOBS_MCP_PORT=8000
MIJOBS_DATABASE_URL=sqlite:////data/mijobs.db
MIJOBS_ARTIFACT_ROOT=/data/artifacts
MIJOBS_MCP_WRITE_ENABLED=false

# Optional official-source credentials. Single-quote values containing $ or #.
BLS_API_KEY=
CENSUS_API_KEY=
ONET_USERNAME=
ONET_PASSWORD=

# Shared network for separately managed agent containers.
MIJOBS_NETWORK_NAME=michigan-workforce

# Optional future Kubernetes deployment; unused by Compose runtime.
MIJOBS_KUBE_NAMESPACE=workforce
MIJOBS_KUBE_IMAGE=michigan-workforce-intelligence:local
MIJOBS_KUBE_STORAGE=10Gi

# MCP hostnames; runtime appends MIJOBS_MCP_PORT. Browser origins denied by default.
MIJOBS_MCP_ALLOWED_HOSTS=127.0.0.1,localhost,workforce-mcp,app
MIJOBS_MCP_ALLOWED_ORIGINS=
